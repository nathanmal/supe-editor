{
    "name": "supe-editor",
    "version": "1.0.0",
    "private": true,
    "description": "Block editor module for the Supe ecosystem: custom blocks and editor modifications.",
    "scripts": {
        "build": "wp-scripts build --webpack-src-dir=blocks --blocks-manifest --experimental-modules",
        "start": "wp-scripts start --webpack-src-dir=blocks --blocks-manifest --experimental-modules",
        "format": "wp-scripts format",
        "lint:js": "wp-scripts lint-js",
        "lint:css": "wp-scripts lint-style \"blocks/**/*.scss\" \"editor/**/*.scss\"",
        "test:js": "wp-scripts test-unit-js",
        "packages-update": "wp-scripts packages-update"
    },
    "devDependencies": {
        "@supe-editor/components": "file:components",
        "@wordpress/block-editor": "^20.0.0",
        "@wordpress/blocks": "^17.1.0",
        "@wordpress/components": "^44.0.0",
        "@wordpress/compose": "^9.1.0",
        "@wordpress/core-data": "^9.2.0",
        "@wordpress/data": "^11.1.0",
        "@wordpress/dependency-extraction-webpack-plugin": "^6.57.0",
        "@wordpress/editor": "^16.1.0",
        "@wordpress/element": "^10.1.0",
        "@wordpress/hooks": "^5.1.0",
        "@wordpress/html-entities": "^5.2.0",
        "@wordpress/i18n": "^7.1.0",
        "@wordpress/icons": "^20.0.0",
        "@wordpress/plugins": "^8.1.0",
        "@wordpress/prettier-config": "^4.57.0",
        "@wordpress/scripts": "^34.2.0",
        "@wordpress/stylelint-config": "^24.3.0"
    }
}
