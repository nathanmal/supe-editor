{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "supe/slide",
    "version": "0.1.0",
    "title": "Slide",
    "category": "supe",
    "icon": "cover-image",
    "description": "A slide that holds any blocks.",
    "textdomain": "supe-editor",
    "parent": [ "supe/slides-track" ],
    "attributes": {
        "verticalAlignment": {
            "type": "string"
        }
    },
    "supports": {
        "anchor": true,
        "background": {
            "backgroundImage": true,
            "backgroundSize": true
        },
        "color": {
            "background": true,
            "gradients": true,
            "link": true,
            "text": true
        },
        "html": false,
        "layout": {
            "allowSwitching": false,
            "allowInheriting": false
        },
        "reusable": false,
        "supe": {
            "spacing": true
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}
