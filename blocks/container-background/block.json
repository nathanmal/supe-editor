{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "supe/container-background",
    "version": "0.2.0",
    "title": "Background",
    "category": "supe",
    "icon": "format-image",
    "description": "A container's background: an image or a looping video under an optional overlay.",
    "textdomain": "supe-editor",
    "parent": [ "supe-container/container" ],
    "attributes": {
        "type": {
            "type": "string",
            "enum": [ "image", "video" ],
            "default": "image"
        },
        "mediaId": {
            "type": "number"
        },
        "posterId": {
            "type": "number"
        },
        "focalPoint": {
            "type": "object"
        },
        "pauseButton": {
            "type": "boolean",
            "default": false
        },
        "overlayColor": {
            "type": "string"
        },
        "overlayGradient": {
            "type": "string"
        },
        "overlayOpacity": {
            "type": "number",
            "default": 50
        }
    },
    "supports": {
        "html": false,
        "inserter": false,
        "renaming": false,
        "reusable": false
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScriptModule": "file:./view.js",
    "render": "file:./render.php"
}
