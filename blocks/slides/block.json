{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "supe/slides",
    "version": "0.1.0",
    "title": "Slides",
    "category": "supe",
    "icon": "slides",
    "description": "A slideshow of images or content.",
    "keywords": [ "slider", "slideshow", "carousel", "gallery" ],
    "textdomain": "supe-editor",
    "attributes": {
        "type": {
            "type": "string",
            "default": ""
        },
        "imageDefaults": {
            "type": "object",
            "default": {}
        },
        "perView": {
            "type": "object"
        },
        "gap": {
            "type": "object"
        },
        "height": {
            "type": "object"
        },
        "heightTarget": {
            "type": "string",
            "enum": [ "slider", "slide" ]
        }
    },
    "providesContext": {
        "supe/slides/type": "type",
        "supe/slides/imageDefaults": "imageDefaults"
    },
    "allowedBlocks": [ "supe/slides-track" ],
    "supports": {
        "align": [ "wide", "full" ],
        "anchor": true,
        "html": false,
        "supe": {
            "spacing": true
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}
