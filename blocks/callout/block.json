{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "supe/callout",
    "title": "Callout",
    "category": "supe",
    "icon": "megaphone",
    "description": "A styled box for highlighting important content, with selectable info/success/warning/danger variants.",
    "keywords": [ "notice", "alert", "highlight", "callout" ],
    "version": "1.0.0",
    "textdomain": "supe-editor",
    "attributes": {
        "content": {
            "type": "string",
            "source": "html",
            "selector": ".supe-callout__content",
            "default": ""
        },
        "variant": {
            "type": "string",
            "default": "info"
        }
    },
    "supports": {
        "align": [ "wide" ],
        "spacing": {
            "margin": true,
            "padding": true
        },
        "anchor": true
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
