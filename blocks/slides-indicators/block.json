{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "supe/slides-indicators",
    "version": "0.1.0",
    "title": "Slide indicators",
    "category": "supe",
    "icon": "slides",
    "description": "One button per slide (or per view) showing where the slider is.",
    "parent": [ "supe/slides-overlay", "supe/slides-bar" ],
    "attributes": {
        "position": {
            "type": "string",
            "default": "bottom-center"
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        },
        "typography": {
            "fontSize": true
        }
    },
    "styles": [
        {
            "name": "dots",
            "label": "Dots",
            "isDefault": true
        },
        {
            "name": "bars",
            "label": "Bars"
        },
        {
            "name": "numbers",
            "label": "Numbers"
        }
    ],
    "textdomain": "supe-editor",
    "editorScript": "file:./index.js",
    "render": "file:./render.php"
}
