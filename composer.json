{
    "name": "nathanmal/supe-editor",
    "description": "Block editor module for the Supe ecosystem: custom blocks and editor modifications.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": { "php": ">=8.1", "nathanmal/supe-core": "^1.0" },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "yoast/wp-test-utils": "^1.2",
        "wp-phpunit/wp-phpunit": "^7.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../supe-core",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": { "Supe\\Editor\\": "src/" },
        "files": [ "bootstrap.php" ]
    },
    "autoload-dev": {
        "psr-4": { "Supe\\Editor\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --configuration phpunit.xml.dist",
        "test:feature": "phpunit --configuration phpunit-integration.xml.dist"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
